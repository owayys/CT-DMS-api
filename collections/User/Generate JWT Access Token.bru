meta {
  name: Generate JWT Access Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth
  body: json
  auth: none
}

body:json {
  {
    "userName": "ryomen",
    "password": "sukuna"
  }
}

script:post-response {
  let data = res.getBody();
  bru.setVar("access_token",data.accessToken);
  bru.setVar("refresh_token",data.refreshToken);
}
